{
 "source": "LoG1 (USA); re/log1/extract_formulas.py; reference implementation in re/log1/model.py",
 "conventions": {
  "division": "truncating toward zero",
  "rand": "rand(n) main RNG -> integer in [0, n] (inclusive!)",
  "rand2": "rand2(n) secondary RNG -> integer in [0, n-1]",
  "frame": "60 Hz frame counter 0x03003B6C"
 },
 "damage_pipeline": {
  "order": [
   "attacker computes raw damage (per attack type below)",
   "hit() 0x08007416: if defender invulnerable (char+0x14 > 0) -> \"clink\" sfx 0x1D, no damage",
   "if attacker is an enemy: raw = min(raw, cap) where cap = player_maxHP // 3 + 1 (0x03000C1C)",
   "if attacker is the player: defender aggro timer char+0x1E = 900 + rand(900) frames",
   "apply_damage() 0x08007352 (defense roll), see below",
   "result 2 (damaged): defender -> hurt state 6; enemies get stun 20 frames (char+0x0A) and invulnerability 80 frames (char+0x14); player only flashes and is reset to Standing",
   "result 1 (killed): defender state 7; if killer is the player: exp += victim exp reward, level up check",
   "result 0 (no damage): clink sfx 0x1D (rate-limited 20 frames)"
  ],
  "verified": "VERIFIED 113/113 apply_damage outcomes (verify_damage.py)"
 },
 "apply_damage": {
  "code": "0x08007352",
  "inputs": [
   "dmg",
   "def = defender char+0x60",
   "hp = defender char+0x4C"
  ],
  "early_out": "if defender is not the player: return 0 when defender char+0x0A (stun) != 0, or when char+0x0B == 2 (dormant) and def != 0",
  "defense_roll": "if def != 0: r = rand(10000); r > 9000: dmg = dmg - def (0 if def > dmg); 7500 < r <= 9000: dmg = dmg - def//2 (0 if def//2 > dmg); 5000 < r <= 7500: dmg = dmg - def//4 (0 if def//4 > dmg); 4800 < r <= 5000: return 0 (miss); r <= 4800: full dmg",
  "probabilities": {
   "full": 0.48005199480051997,
   "miss": 0.019998000199980003,
   "quarter_def": 0.24997500249975002,
   "half_def": 0.14998500149985,
   "full_def": 0.0999900009999
  },
  "kill": "if dmg >= hp: hp = 0, alive (char+0x9C) = 0, return 1 (unless god-mode flag 0x03000C18 and defender is player)",
  "damage": "elif dmg != 0: hp -= dmg, return 2; else return 0",
  "note": "signed compares: a negative dmg (see enemy melee bug) heals the defender when the roll is <= 4800"
 },
 "player_melee": {
  "expr": "(maxHP * (384 + rand2(128))) >> 9",
  "code": "0x08005676",
  "verified": "VERIFIED 10/10"
 },
 "player_ki_blast": {
  "expr": "maxHP // 3",
  "code": "0x0800B596",
  "verified": "VERIFIED"
 },
 "player_kamehameha": {
  "expr": "ki_spent_charging",
  "code": "0x0800BD20 (msg damage = projectile+0x24)",
  "verified": "VERIFIED"
 },
 "charge_cost_player": {
  "expr": "(maxKi + 15) >> 4",
  "period_frames": 8,
  "code": "0x0800B50A / 0x0800B436"
 },
 "solar_flare_duration": {
  "expr": "60 + min(charge, maxKi) * 300 // maxKi",
  "cooldown": "duration + 60",
  "code": "0x0800B692",
  "verified": "VERIFIED (charge 125/400 -> 153 frames)"
 },
 "enemy_melee": {
  "expr": "hp // 4 + rand(hp // 2)",
  "hp": "attacker CURRENT hp (char+0x4C)",
  "code": "0x0800F7EC",
  "bug": "rand(n) uses signed asr: when (prod*(n+1)) >= 2^31 (possible once n >= 32768) the result is negative -> damage can be negative (heals the player on a full-damage roll)",
  "verified": "VERIFIED range + negative case observed"
 },
 "enemy_ki_blast": {
  "expr": "maxHP // 3",
  "power_expr": "rand(ki // 2) + ki // 4",
  "chance": "rand(100) <= 1",
  "code": "0x0800F8FC / 0x0800B596",
  "verified": "VERIFIED"
 },
 "damage_cap_vs_player": {
  "expr": "player_maxHP // 3 + 1",
  "code": "0x08006D70"
 },
 "exp": {
  "on_kill": "player_exp += victim.exp_reward (template +0x0C)",
  "code": "0x08007518",
  "level": "largest i with level_table[i].exp <= exp (level = i + 1)",
  "code_level": "0x08005C32",
  "table": "levels.json",
  "verified": "VERIFIED (340 + wolf 70 -> level 2, HP 80 -> 175, maxKi 150)"
 },
 "level_up": {
  "code": "0x08005BFE",
  "maxHP": "table",
  "maxKi": "table",
  "hp": "hp += newMaxHP - oldMaxHP",
  "ki": "unchanged",
  "ki_regen": "maxKi >> 6",
  "defense": "unchanged (250)"
 },
 "ki_regen": {
  "expr": "ki = min(maxKi, ki + (maxKi >> 6))",
  "when": "frame_counter & 15 == 0 and not flying (0x030007DC == 0) [player]; enemies: frame_counter & 15 == 0 while awake",
  "code": "0x08008032 / 0x08008312",
  "verified": "VERIFIED (+1 per 16 frames at maxKi 100)"
 },
 "hp_regen": {
  "expr": "none",
  "verified": "VERIFIED (no change over 960 frames)"
 },
 "heal_items": {
  "herb": "hp = min(maxHP, hp + maxHP // 4)",
  "senzu": "hp = maxHP",
  "code": "0x0800170C / 0x08001730"
 },
 "flight": {
