  "code": "0x080085D2 / 0x08008176",
  "also": "or aggro timer char+0x1E != 0 (set 900..1800 frames when the player hits it); the enemy must also be within 144 px (0x5100 = 144^2) of the screen centre"
 },
 "enemy_target": {
  "expr": "manhattan_tiles(enemy, player) <= aggro_tiles",
  "code": "0x08007680"
 },
