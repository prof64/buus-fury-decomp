   "+0xe u16": "END 8.8",
   "+0x10 u32": "exp",
   "+0x14 u32": "flags: bit0 = character unlocked/selectable (Switch list, status list); bit1 = counted by 0x08003e1e (INFERRED in-party); bits3..6 = special slots 0..3 usable",
