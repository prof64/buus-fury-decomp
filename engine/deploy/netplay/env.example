# copy to .env (never commit .env) and fill in
# the domain whose A record points at this machine (Caddy gets its certificate; coturn's realm)
WF_DOMAIN=play.example.com
# this machine's public IPv4 (TURN relay candidates)
PUBLIC_IP=203.0.113.7
# shared secret between wf-signal and the TURN server: openssl rand -hex 32
TURN_SECRET=change-me
# optional: a key every client must send (?key= / --net-key / the web app's &key=); keeps strangers off your
# server and TURN quota. Empty = open server (room tokens still protect rooms).
WF_SIGNAL_KEY=
# 1 = refuse rooms without a room token (the in-game host always makes one on a non-local server)
WF_REQUIRE_TOKEN=1
