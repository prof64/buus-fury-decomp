# TLS in front of wf-signal: wss://{$WF_DOMAIN}/wf-<ROOM> (WebSocket upgrade passes through reverse_proxy as is)
# and https://{$WF_DOMAIN}/ice. Caddy gets and renews the Let's Encrypt certificate by itself (ports 80 + 443 open,
# the domain's A record pointing at this machine).
{$WF_DOMAIN} {
	encode zstd gzip
	reverse_proxy signal:3536 {
		# the signaling server logs the real client address
		header_up X-Forwarded-For {remote_host}
	}
	header {
		# the browser game may be served from another origin (GitHub Pages, itch.io, localhost)
		Access-Control-Allow-Origin *
		-Server
	}
	log {
		output stdout
		format console
	}
}
